# Copy to .env at repo root (never commit .env)

# Supabase (all server-side / import scripts)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: season window for aggregation API (YYYY-MM-DD)
# SEASON_START=2025-03-15

# API server (apps/api)
# PORT=3001
# PUBLIC_APP_URL=http://localhost:5173

# Stripe billing (apps/api)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_LOOKUP_KEY_BASIC_MONTHLY=ah_basic_monthly
# STRIPE_PRICE_LOOKUP_KEY_PLUS_MONTHLY=ah_plus_monthly

# Web app — client-safe keys only (apps/web/.env)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# Optional: full URL to API in production (defaults to same-origin / Vite proxy in dev)
# VITE_API_BASE_URL=

# GitHub Actions / Slack (optional)
# SLACK_WEBHOOK_URL=
